@startuml MiniShopify Models

' Model Classes
entity Merchant {
  - Long id
  - String name
  - String email
  - String password
  - UserType userType
  - List<Shop> shops
  --
  + Long getId()
  + void setId(Long id)
  + String getName()
  + void setName(String name)
  + String getEmail()
  + void setEmail(String email)
  + String getPassword()
  + void setPassword(String password)
  + UserType getUserType()
  + List<Shop> getShops()
  + void setShops(List<Shop> shops)
  + void removeShop(long shopId)
}

entity Shop {
  - Long id
  - String name
  - List<String> categories
  - List<Product> products
  - Merchant merchant
  --
  + Long getId()
  + void setId(Long id)
  + String getName()
  + void setName(String name)
  + List<String> getCategories()
  + void addCategory(String category)
  + Merchant getMerchant()
  + void setMerchant(Merchant merchant)
  + List<Product> getProducts()
  + void addProduct(Product product)
  + void removeProduct(long productId)
}

entity Product {
  - Long id
  - String name
  - String description
  - double price
  - int stock
  - String imageUrl
  - Shop shop
  --
  + Long getId()
  + void setId(Long id)
  + String getName()
  + void setName(String name)
  + String getDescription()
  + void setDescription(String description)
  + double getPrice()
  + void setPrice(double price)
  + int getStock()
  + void setStock(int stock)
  + String getImageUrl()
  + void setImageUrl(String imageUrl)
  + Shop getShop()
  + void setShop(Shop shop)
  + void addStock(int stockToAdd)
  + boolean removeStock(int stockToRemove)
}

entity Customer {
  - Long id
  - String name
  - String email
  - String password
  - UserType userType
  - Cart cart
  --
  + Long getId()
  + void setId(Long id)
  + String getName()
  + void setName(String name)
  + String getEmail()
  + void setEmail(String email)
  + String getPassword()
  + void setPassword(String password)
  + UserType getUserType()
  + Cart getCart()
  + void setCart(Cart cart)
}

entity Cart {
  - Long cartID
  - List<CartItem> cartItems
  - Customer customer
  --
  + Long getCartID()
  + void setCartID(Long cartID)
  + Customer getCustomer()
  + void setCustomer(Customer customer)
  + List<CartItem> getCartItems()
  + void setCartItems(List<CartItem> cartItems)
  + boolean addProduct(Product product, int quantity)
  + boolean removeProduct(Product product)
  + boolean reduceProductQuantity(Product product, int quantity)
  + double calculateTotal()
  + void clearCart()
}

entity CartItem {
  - Long id
  - int quantity
  - Product product
  - Cart cart
  --
  + Long getId()
  + void setId(Long id)
  + int getQuantity()
  + void setQuantity(int quantity)
  + Product getProduct()
  + void setProduct(Product product)
  + Cart getCart()
  + void setCart(Cart cart)
}

enum UserType {
  CUSTOMER
  MERCHANT
}

' Relationships
Merchant "1" -- "0..*" Shop : owns >
Shop "1" -- "0..*" Product : contains >
Customer "1" -- "1" Cart : has >
Cart "1" -- "0..*" CartItem : contains >
CartItem "*" --> "1" Product : references >

@enduml
